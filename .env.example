# Copy to .env for local development. Never commit real credentials.
# Exact trusted application origin; required in production (no trailing slash).
APP_ORIGIN=http://localhost:3000
# Server-only: obtain a key for this project; do not reuse another project's key.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
# Supported exact IDs: qwen3.5:9b or gemma4:26b; verify this key's /models access.
# Listed in /models is not the same as serving: gemma4:26b answered 503 with
# "no healthy provider backends" on 2026-11-10 while qwen3.5:9b worked.
SOCLAAS_CHAT_MODEL=
# Deliberately unimplemented: no code reads this. A silent switch to another
# model on a 503 would hide a provider outage instead of surfacing it, so a
# failed call stays a visible upstream_http failure. Decided 2026-11-10.
SOCLAAS_FALLBACK_CHAT_MODEL=

# Supabase development project. Public values may be included in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required by trusted AI turn admission/completion; never expose.
# Local db:env provides the disposable local worker key. Never use a hosted key locally.
SUPABASE_SECRET_KEY=
