{
  "name": "specforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:e2e": "node src/tooling/test-local.mjs browser",
    "test:e2e:smoke": "node src/tooling/test-local.mjs browser @smoke",
    "test:integration": "node src/tooling/test-local.mjs",
    "screenshots": "node src/tooling/screenshots.mjs",
    "db:start": "node src/tooling/database.mjs start",
    "db:stop": "node src/tooling/database.mjs stop",
    "db:reset": "node src/tooling/database.mjs reset",
    "db:env": "node src/tooling/database.mjs env",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "3.10.1",
    "supabase": "^2.121.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
