{
  "name": "specforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": { "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.1" } },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node src/tooling/test-local.mjs browser",
    "test:integration": "node src/tooling/test-local.mjs",
    "db:start": "node src/tooling/database.mjs start",
    "db:stop": "node src/tooling/database.mjs stop",
    "db:reset": "node src/tooling/database.mjs reset",
    "db:env": "node src/tooling/database.mjs env",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "supabase": "^2.121.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
